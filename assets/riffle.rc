1 ICON "__ICON__"

1 VERSIONINFO
FILEVERSION __VERSION_NUMBERS__
PRODUCTVERSION __VERSION_NUMBERS__
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "FileDescription", "Riffle - lightweight web browser with ad blocking"
      VALUE "ProductName", "Riffle"
      VALUE "FileVersion", "__VERSION__"
      VALUE "ProductVersion", "__VERSION__"
      VALUE "InternalName", "riffle-browser"
      VALUE "OriginalFilename", "riffle-browser.exe"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
